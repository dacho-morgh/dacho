{
  "name": "@dacho/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API — Express service owning application auth (OTP-first), workflow instances, and request processing.",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.mts",
    "test:int": "vitest run --config ./vitest.int.config.mts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "multer": "^2.0.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@dacho/cms-core": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
