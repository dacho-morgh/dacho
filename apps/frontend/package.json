{
  "name": "@dacho/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Fused CMS + frontend — Next.js + Payload app serving admin UI, REST/GraphQL API, and public site.",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "lint:ox": "oxlint .",
    "lint:ox:fix": "oxlint --fix .",
    "create:admin": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/create-admin.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:service-account": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-service-account.ts",
    "seed:landing": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-landing.ts",
    "seed:dashboard": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-dashboard.ts",
    "seed:forms": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-forms.ts",
    "seed:all": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-all.ts",
    "prepare": "husky || true",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=test vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dacho/cms-core": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@payloadcms/admin-bar": "3.86.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-form-builder": "3.86.0",
    "@payloadcms/plugin-nested-docs": "3.86.0",
    "@payloadcms/plugin-redirects": "3.86.0",
    "@payloadcms/plugin-search": "3.86.0",
    "@payloadcms/plugin-seo": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "gsap": "^3.15.0",
    "lucide-react": "0.563.0",
    "next": "^16.3.0",
    "next-sitemap": "^4.2.3",
    "payload": "3.86.0",
    "prism-react-renderer": "^2.3.1",
    "radix-ui": "^1.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "28.0.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.56.0",
    "oxlint": "1.71.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "^4.1.10"
  }
}
