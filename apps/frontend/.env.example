# Postgres connection string — matches apps/frontend/docker-compose.yml (user/pass/db: dacho)
DATABASE_URL=postgres://dacho:dacho@127.0.0.1:5432/dacho-cms

# Signs Payload auth/JWT tokens. REQUIRED — the server refuses to start without it.
PAYLOAD_SECRET=

# Used to configure CORS, format links and more. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs (optional)
CRON_SECRET=

# Used to validate preview requests (optional)
PREVIEW_SECRET=

# JWKS endpoint of the backend — Payload verifies backend-issued ES256 tokens here
# (the `backend-jwt` strategy in cms-core). Optional; backend OTP auth only works if set.
BACKEND_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# The /api/dashboard/* proxy forwards to this backend (same-origin -> backend service).
BACKEND_URL=http://localhost:4000

# Shared with the backend — the proxy sends it as x-internal-proxy-secret. Must match.
INTERNAL_PROXY_SECRET=
