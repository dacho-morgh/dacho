{
  "name": "@dacho/cms-core",
  "version": "0.1.0",
  "private": true,
  "description": "React-free Payload CMS domain: config, collections, globals, fields, hooks, access, and generated types. No Next.js, no React.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "payload": "3.86.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "5.7.3"
  }
}
