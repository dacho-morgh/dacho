# apps/backend — required. The server throws at startup if any are missing/empty.
PORT=4000
DATABASE_URL=postgres://dacho:dacho@localhost:5432/dacho-cms
JWT_PRIVATE_KEY=            # PKCS8 PEM (ES256). Generate: openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
PAYLOAD_URL=http://localhost:3000
PAYLOAD_API_KEY=            # printed by: pnpm --filter @dacho/frontend seed:service-account

# apps/backend — optional
JWT_KID=dacho-backend
OTP_DELIVERY=console        # console | kavenegar

# Required only when OTP_DELIVERY=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
