# apps/backend — required. The server throws at startup if any are missing/empty.
PORT=4000
DATABASE_URL=postgres://dacho:dacho@localhost:5432/dacho-cms
JWT_PRIVATE_KEY=            # PKCS8 PEM (ES256). Docker: use JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key + secrets/jwt-private.pem instead. Generate: openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
PAYLOAD_URL=http://localhost:3000
PAYLOAD_API_KEY=            # printed by: pnpm --filter @dacho/frontend seed:service-account
INTERNAL_PROXY_SECRET=      # shared secret the Next.js proxy sends as x-internal-proxy-secret

# apps/backend — optional
JWT_KID=dacho-backend
OTP_DELIVERY=console        # console | kavenegar
# Private document bytes. Must be persistent and outside public media/static.
# Docker Compose mounts a separate volume here.
PRIVATE_DOCUMENTS_DIR=.private-documents

# Required only when OTP_DELIVERY=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
