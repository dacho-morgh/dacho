[Unit]
Description=Deploy Dacho images after GitHub Actions publishes them
Wants=network-online.target dacho-maintenance.service
After=network-online.target docker.service dacho-maintenance.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
Environment=HOME=/home/ubuntu
WorkingDirectory=/home/ubuntu/dev/dacho
ExecStart=/usr/bin/bash /home/ubuntu/.local/bin/dacho-deploy-production
TimeoutStartSec=30min
