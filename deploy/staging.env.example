# Copy to .env.staging.local (gitignored) and pass with --env-file.
# STAGING_IMAGE_SUFFIX may be blank (floating staging tag) or -sha-<7-hex>.
STAGING_IMAGE_SUFFIX=-sha-abcdef0
STAGING_POSTGRES_PASSWORD=<url-safe-hex-password>
STAGING_PUBLIC_URL=https://<staging-hostname>
STAGING_PAYLOAD_API_KEY=<staging-service-account-key>
STAGING_INTERNAL_PROXY_SECRET=<staging-shared-proxy-secret>
STAGING_OTP_DELIVERY=console
# Set these only when STAGING_OTP_DELIVERY=kavenegar.
STAGING_KAVENEGAR_API_KEY=
STAGING_KAVENEGAR_TEMPLATE=testtemplate
